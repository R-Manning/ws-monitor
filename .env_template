# ───────── Runtime ─────────
# The Pi service uses this persistent path outside the application checkout.
# On macOS, use an absolute path under the project or ~/Library/Application Support.
WSM_DB_PATH=/var/lib/ws-monitor/house_environment.db
WSM_SENSOR_MODE=auto
WSM_SAMPLE_INTERVAL=5
WSM_HISTORY_DAYS=7
WSM_SENSOR_RETRIES=2
WSM_LOG_LEVEL=INFO
WSM_LOG_DIR=
# Back off re-probing a flaky DHT11 for this many seconds after a failed read.
WSM_DHT_COOLDOWN_S=30
# Reject MAX31856 (thermocouple) readings above these Fahrenheit ceilings as
# implausible; a saturated read near 1000 F is rejected regardless.
WSM_STT_MAX_F=1100
WSM_FLUE_MAX_F=850
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10

# Set false on installations without an RTSP camera.
WSM_CAMERA_ENABLED=true

# ───────── Telegram (keep secret) ───────── 
TELEGRAM_BOT_TOKEN=bot_token
TELEGRAM_CHAT_ID=chat_id

# ───────── Camera (keep secret) ─────────
WYZE_RTSP_URL=rtsp://thingino:thingino@your_cam_ip/ch0

# ───────── Video pipeline tuning ─────────
# The stream is relayed to browsers via WebRTC with the camera's native
# framerate/resolution (no server-side transcoding or JPEG encoding).
RECONNECT_DELAY_S=3
