[Unit]
Description=Wood Stove Monitor dashboard
After=network-online.target ws-monitor-collector.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ws-monitor
EnvironmentFile=-/etc/ws-monitor/ws-monitor.env
Environment=PYTHONPATH=/opt/ws-monitor/src
ExecStart=/opt/ws-monitor/.venv/bin/python /opt/ws-monitor/src/dashwebapp.py
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
